@page "/Category/Detail/{id:int}"
@rendermode InteractiveServer

@inject IJSRuntime JS
@inject ICategoryRepository CategoryRepository
@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage

<PageTitle>
    Categoria - Confirmar exclusão
</PageTitle>

<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Categoria - Confirmar Exclusão dos Registros</h4>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label class="form-label">Nome</label>
                        <br />
                        @Category!.Name
                    </div>

                </div>
                <div class="row mt-3">
                    <div class="col-lg-12">
                        <div class="d-flex justify-content-between">
                            <a href="/Category/List" class="btn btn-light">Voltar</a>
                            <button @onclick="Remove" type="button" class="btn btn-soft-danger">
                                Confirmar Exclusão
                                <i class="ri-delete-bin-line"></i>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@code {
    [Parameter] public int Id { get; set; }
    private Category Category { get; set; } = new();


    protected override async Task OnParametersSetAsync()
    {
        var category = await CategoryRepository.Get(Id);
        if (category is not null)
            this.Category = category;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (Category.Id == 0)
            {
                await JS.InvokeVoidAsync("alert", "A categoria selecionada não existe no banco!");
                NavigationManager.NavigateTo("/Category/List");
                return;
            }
            var company = await LocalStorage.GetItemAsync<Company>(AppConstants.LocalStorageCampany);

            if (Category!.CompanyId != company!.Id)
            {
                await JS.InvokeVoidAsync("alert", $"A categoria não pertence a empresa '{company.LegalName}'");
                NavigationManager.NavigateTo("/Category/List");
            }
        }
    }

    private async Task Remove()
    {
        await CategoryRepository.Delete(Category.Id);

        await JS.InvokeVoidAsync("alert", "Registro excluido com sucesso!");
        NavigationManager.NavigateTo("/Category/List");
    }

}
