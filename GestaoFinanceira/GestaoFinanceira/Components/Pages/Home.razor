@page "/"
@inherits PageBase

@attribute [Authorize]
@inject ApplicationDbContext DB
@rendermode InteractiveServer

<PageTitle>Painel</PageTitle>
<div class="row">
    <GestaoFinanceira.Components.Pages.Painel.Totalizadores />
    <GestaoFinanceira.Components.Pages.Painel.AccountBalance />
</div>

<GestaoFinanceira.Components.Pages.Painel.AccssLink />
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var company = await LocalStorage.GetItemAsync<Gestao.Domain.Company>(AppConstants.LocalStorageCampany);
            if (company is null)
                NavigationManager.NavigateTo("/Company/List");
        }

    }
}















