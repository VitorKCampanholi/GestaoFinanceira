@inject ApplicationDbContext DB
@inject ILocalStorageService LocalStorage

@if (Company is not null)
{
    <div class="col-xl-4 col-md-6">
        <!-- card -->
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1 overflow-hidden">
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Total Recebido</p>
                    </div>
                </div>

                <div class="d-flex align-items-end justify-content-between mt-4">
                    <div>
                        <h4 class="fs-22 fw-semibold ff-secondary mb-4">
                            @(TotalFinancialTransactionReceive.HasValue
                                                    ? TotalFinancialTransactionReceive.Value.ToString("C")
                                                    : "-")
                                                      </h4>
                                                  </div>

                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-success-subtle rounded fs-3">
                            <i class="bx bx-dollar-circle text-success"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- end col -->

    <div class="col-xl-4 col-md-6">
        <!-- card -->
        <div class="card card-animate">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1 overflow-hidden">
                        <p class="text-uppercase fw-medium text-muted text-truncate mb-0">
                            Total Pago
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-end justify-content-between mt-4">
                    <div>
                        <h4 class="fs-22 fw-semibold ff-secondary mb-4">
                            @(TotalFinancialTransactionPayed.HasValue
                                                    ? TotalFinancialTransactionPayed.Value.ToString("C")
                                                    : "-")
                    </h4>
                </div>

                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-primary-subtle rounded fs-3">
                            <i class="bx bx-wallet text-primary"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- end col -->
}

@code {
    private decimal? TotalFinancialTransactionPayed;
    private decimal? TotalFinancialTransactionReceive;
    private Company? Company;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Company = await LocalStorage.GetItemAsync<Company>(AppConstants.LocalStorageCampany);
            if (Company is null) return;

            FinancialTransactionPayed();
            FinancialTransactionReceive();
            StateHasChanged();
        }
    }

    private void FinancialTransactionPayed()
    {
        TotalFinancialTransactionPayed = DB.FinancialTransctions
            .Where(a => a.TypeFinancialTransction == TypeFinancialTransction.Pay && a.CompanyId == Company!.Id)
            .Sum(a => a.AmoundPaid);
    }

    private void FinancialTransactionReceive()
    {
        TotalFinancialTransactionReceive = DB.FinancialTransctions
            .Where(a => a.TypeFinancialTransction == TypeFinancialTransction.Receive && a.CompanyId == Company!.Id)
            .Sum(a => a.AmoundPaid);
    }
}