@page "/Company/Detail/{id:int}"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICompanyRepository CompanyRepository
@inject NavigationManager NavigationManager

<PageTitle>
    Empresa - Detalhe
</PageTitle>

<div class="row">
    <div class="col-lg-12">
        <div class="card">

            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Empresa - Confirmar Exclusão dos Registros</h4>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="razaoSocial" class="form-label">Razão Social</label>
                        <br />
                        @Company!.LegalName
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="nomeFantasia" class="form-label">Nome Fantasia</label>
                        <br />
                        @Company!.TradeName
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="cnpj" class="form-label">CNPJ</label>
                        <br />
                        @Company!.TaxId
                    </div>

                </div>

                <div class="row mt-1">

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="cep" class="form-label">CEP</label>
                        <br />
                        @Company!.PostalCode
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="estado" class="form-label">Estado</label>
                        <br />
                        @Company!.State
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="cidade" class="form-label">Cidade</label>
                        <br />
                        @Company!.City
                    </div>

                </div>

                <div class="row">

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="bairro" class="form-label">Bairro</label>
                        <br />
                        @Company!.Neighborhood
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="endereco" class="form-label">Endereço</label>
                        <br />
                        @Company!.Address
                    </div>

                    <div class="col-xxl-3 col-md-6 mt-3">
                        <label for="complemento" class="form-label">Complemento</label>
                        <br />
                        @Company!.Complement
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-lg-12">
                        <div class="d-flex justify-content-between">
                            <a href="/Company/List" class="btn btn-light">Voltar</a>
                            <button @onclick="Remove" type="button" class="btn btn-soft-danger">
                                Confirmar Exclusão
                                <i class="ri-delete-bin-line"></i>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@code {
    [Parameter] public int Id { get; set; }
    private Gestao.Domain.Company Company { get; set; } = new();


    protected override async Task OnParametersSetAsync()
    {

        var userid = (await AthenticationHelper.GetAuthenticationUserIdAsync(AuthenticationStateProvider)).Value;
        var company = await CompanyRepository.Get(Id);

        if (company is null)
        {
            await JS.InvokeVoidAsync("alert", "A empresa selecionada não existe no banco!");
            NavigationManager.NavigateTo("/Company/List");
        }
        if (company!.UserId != userid)
        {
            await JS.InvokeVoidAsync("alert", "A empresa não pertence ao usuário logado!");
            NavigationManager.NavigateTo("/Company/List");
        }
        Company = company;
    }

    private async Task Remove()
    {
        await CompanyRepository.Delete(Company.Id);

        await JS.InvokeVoidAsync("alert", "Registro excluido com sucesso!");
        NavigationManager.NavigateTo("/Company/List");
    }
    
}
