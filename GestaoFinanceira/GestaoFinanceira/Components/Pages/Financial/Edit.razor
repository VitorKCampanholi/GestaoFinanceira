@page "/Financial/{Type}/Edit/{id:int}"
@rendermode InteractiveServer
@inject IFinancialTransactionsRepository FinancialTransactionsRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IQueue Queue

@if (Type is not null)
{
    <PageTitle>
        @TypeFinancialTransactionToString.Converter(Type).ToUpper() - ATUALIZAR
    </PageTitle>
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                @if (Type is not null)
                {
                    <h4 class="card-title mb-0 flex-grow-1">Atualizar @TypeFinancialTransactionToString.Converter(Type)</h4>
                }
            </div>
            <div class="card-body">
                @if (FinancialTransction is not null)
                {
                    <FinancialTransactionForm IsEditForn="@true" FinancialTransaction="FinancialTransction" Type="@Type" OnSave="Save" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Type { get; set; }
    [Parameter]
    public int Id { get; set; }

    public FinancialTransction FinancialTransction { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        FinancialTransction = (await FinancialTransactionsRepository.Get(Id))!;
    }

    private async Task Save(FinancialTransction financialTransaction)
    {

        await FinancialTransactionsRepository.Update(financialTransaction);
        Queue.QueueInvocableWithPayload<FinancialTransacitonRepeatInvocable, FinancialTransction>(financialTransaction);

        
        await JS.InvokeVoidAsync("alert", "Registro salvo com sucesso! Caso tenha parcelas, o processamento pode demorar alguns segundos para acontecer!");
        NavigationManager.NavigateTo($"/Financial/{Type}/List");
    }
}
